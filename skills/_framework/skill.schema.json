{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExecutableSkillManifest","type":"object","additionalProperties":false,"required":["name","version","domain","risk","entrypoint","inputs","outputs","approvals","evidence","lifecycle"],"properties":{"name":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]+$"},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"domain":{"enum":["video","agentic","devsecops","sre","research","skill-generation"]},"risk":{"enum":["low","medium","high","critical"]},"entrypoint":{"type":"string","pattern":"^scripts/"},"inputs":{"type":"object"},"outputs":{"type":"object"},"approvals":{"type":"array","items":{"type":"string"}},"evidence":{"type":"array","minItems":1,"items":{"type":"string"}},"lifecycle":{"enum":["DRAFT","REVIEWED","TESTED","VALIDATED","PRODUCTION","DEPRECATED"]},"external_writes":{"type":"boolean","default":false},"self_promotion":{"type":"boolean","const":false}}}