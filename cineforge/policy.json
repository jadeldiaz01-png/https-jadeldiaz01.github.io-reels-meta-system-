{
  "version": "1.0.0",
  "default_decision": "BLOCKED",
  "research": {
    "allowlisted_sources_only": true,
    "official_apis_preferred": true,
    "respect_terms_and_robots": true,
    "anti_bot_bypass": false,
    "cloudflare_stealth_bypass": false,
    "credential_harvesting": false
  },
  "generation": {
    "require_original_concept": true,
    "require_rights_or_permission_for_references": true,
    "require_visual_bible": true,
    "require_shot_contract": true,
    "require_continuity_gate_before_render": true,
    "provider_fallback_allowed": true,
    "fallback_must_preserve_quality_floor": true,
    "silent_quality_downgrade": false
  },
  "publication": {
    "human_approval_required": true,
    "autonomous_external_publish": false,
    "spam_or_engagement_manipulation": false,
    "impersonation": false
  },
  "quality": {
    "minimum_width": 1080,
    "minimum_height": 1920,
    "preferred_aspect_ratio": "9:16",
    "minimum_audio_sample_rate_hz": 48000,
    "required_video_codec": "h264",
    "required_audio_codec": "aac",
    "reject_on_critical_visual_defect": true,
    "reject_on_continuity_failure": true,
    "reject_on_policy_failure": true
  },
  "finops": {
    "estimate_cost_before_render": true,
    "require_budget_check": true,
    "record_actual_cost": true,
    "prefer_quality_per_dollar_routing": true
  },
  "provenance": {
    "record_model_and_provider": true,
    "record_prompt_hash": true,
    "record_reference_asset_ids": true,
    "record_output_sha256": true,
    "record_qc_result": true
  }
}